{
    "name": "interview/inventory-api",
    "description": "Take-home interview exercise: a small PHP inventory/order API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "seed": "php database/seed.php",
        "serve": "php -S localhost:8000 -t public"
    }
}
